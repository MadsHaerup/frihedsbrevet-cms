---
import Icon from '../Icon.astro';
import { useT } from '../../i18n';
const t = useT(Astro.locals.lang);
---
<div class="fmt" role="toolbar" aria-label={t('tb.label')}>
  <button type="button" data-cmd="bold" aria-label={t('tb.bold')} data-tip={`${t('tb.bold')} ⌘B`}><b>B</b></button>
  <button type="button" data-cmd="italic" aria-label={t('tb.italic')} data-tip={`${t('tb.italic')} ⌘I`}><i>I</i></button>
  <button type="button" data-cmd="underline" aria-label={t('tb.underline')} data-tip={`${t('tb.underline')} ⌘U`}><u>U</u></button>
  <span class="fmt-rule"></span>
  <button type="button" data-cmd="h2" aria-label={t('tb.heading')} data-tip={t('tb.heading')}>H2</button>
  <button type="button" data-cmd="ul" aria-label={t('tb.ul')} data-tip={t('tb.ul')}>
    <Icon name="ul" />
  </button>
  <button type="button" data-cmd="ol" aria-label={t('tb.ol')} data-tip={t('tb.ol')}>
    <Icon name="ol" />
  </button>
  <button type="button" data-cmd="quote" aria-label={t('tb.quote')} data-tip={t('tb.quote')}>
    <Icon name="quote" />
  </button>
  <span class="fmt-rule"></span>
  <button type="button" data-cmd="dropcap" aria-label={t('tb.dropcap')} data-tip={t('tb.dropcap')}>
    <Icon name="dropcap" />
  </button>
  <button type="button" data-cmd="link" aria-label={t('tb.link')} data-tip={`${t('tb.link')} ⌘K`}>
    <Icon name="link" />
  </button>
  <button type="button" data-cmd="image" aria-label={t('tb.image')} data-tip={t('tb.image')}>
    <Icon name="image" />
  </button>
  <div class="menu insert" data-menu>
    <button type="button" class="menu-btn" aria-haspopup="menu" aria-expanded="false" aria-label={t('tb.insert')} data-tip={t('tb.insert')}>
      <Icon name="plus" />
      <Icon name="caret" size={12} class="chev" />
    </button>
    <div class="menu-pop" role="menu" hidden>
      <button type="button" role="menuitem" data-cmd="sec2">{t('ins.sec2')}</button>
      <button type="button" role="menuitem" data-cmd="sec3">{t('ins.sec3')}</button>
      <button type="button" role="menuitem" data-cmd="section">{t('ins.section')}</button>
      <button type="button" role="menuitem" data-cmd="callout">{t('ins.callout')}</button>
      <button type="button" role="menuitem" data-cmd="pull">{t('ins.pull')}</button>
      <button type="button" role="menuitem" data-cmd="embed">{t('ins.embed')}</button>
      <button type="button" role="menuitem" data-cmd="code">{t('ins.code')}</button>
    </div>
  </div>
</div>
